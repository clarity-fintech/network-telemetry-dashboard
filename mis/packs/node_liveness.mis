  invariant node_liveness_080: node_liveness_080_bound == true;

  outcome assert_pack(payload: Bytes) {
    require payload != @0;
    constraint pack_bound == true;
  }

  outcome settle_clrty1(intent: Bytes) {
    require intent != @0;
    constraint chain_id == 1202;
  }

  outcome assert_node_liveness_061(payload: Bytes) {
    require payload != @0;
    constraint node_liveness_061_bound == true;
    constraint chain_id == 1202;
  }

